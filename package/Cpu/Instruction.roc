            _ => make(Kil, Implied, 11, Bool.False) # unreachable: all 256 byte values are listed above
        }
}

expect Instruction.lookup(0xA9).op == Lda
expect Instruction.lookup(0xA9).cycles == 2
expect Instruction.lookup(0x6C).mode == Indirect
expect Instruction.lookup(0xBD).penalty == Bool.True
expect Instruction.lookup(0x9D).penalty == Bool.False # STA abs,X pays the fixed 5
